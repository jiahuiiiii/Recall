# ---------------------------------------------------------------------------
# Bedrock
# ---------------------------------------------------------------------------
# Region is set twice in most setups (SSO region vs CLI default) and Bedrock
# follows the CLI default -- pin it here so both agree.
AWS_REGION=ap-southeast-1

# WORKSHOP ACCOUNT (SSO): uncomment, then `aws sso login --profile workshop`
# AWS_PROFILE=workshop

# PERSONAL ACCOUNT (no SSO): leave AWS_PROFILE unset and run `aws configure`
# with an IAM user access key. Your IAM user needs the AWS managed policy
# 'AmazonBedrockFullAccess'. Do NOT put the secret key in this file -- let
# `aws configure` write it to ~/.aws/credentials, which is gitignored by default
# and not sitting in your repo.

# Override the model id when the account cannot call the code default. Personal
# accounts usually cannot: Anthropic and OpenAI models on Bedrock are gated
# behind a marketplace subscription form, and the symptom is
# `ValidationException: invalid model identifier`, which reads like a typo.
# Amazon Nova is first-party and works without that gate. Confirm with:
#   uv run 00_check_bedrock.py --list-models
RECALL_MODEL_ID=global.amazon.nova-2-lite-v1:0
# On an account with Anthropic access, use e.g.:
# RECALL_MODEL_ID=apac.anthropic.claude-haiku-4-5-20251001-v1:0

# ---------------------------------------------------------------------------
# Transcription. Free tier. Only needed to run audio memos rather than text.
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Enrichment. Optional -- the enricher falls back to keyless DuckDuckGo search.
# Set at most one; first match wins in this order.
# ---------------------------------------------------------------------------
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# ---------------------------------------------------------------------------
# Backends
# ---------------------------------------------------------------------------
# Memory: local (JSON on disk) | agentcore
RECALL_MEMORY=local
RECALL_STORE_PATH=data/person_graph.json

# Calendar: local (JSON ledger) | ics | mcp
#
#   local  the default. A JSON file. Free, offline, and nothing leaves the box.
#   ics    writes a .ics file per follow-up. Opens in Google, Apple, Outlook --
#          no credentials, no API, no account, no setup for anyone. This is the
#          only backend that works for a user who is not you.
#   mcp    Google Calendar over MCP. Needs a Google Cloud project and an OAuth
#          client on the machine, i.e. a developer credential. See below.
RECALL_CALENDAR=local
# RECALL_ICS_DIR=data/ics
# GCAL_MCP_COMMAND=npx -y @cocal/google-calendar-mcp
# GCAL_MCP_TOOL=create-event
#
# The MCP server needs its OWN credentials, separate from anything above, and it
# refuses to start without them -- download an OAuth client (Desktop) from the
# Google Cloud Console with the Calendar API enabled. The child process inherits
# this environment, so setting it here is enough.
# GOOGLE_OAUTH_CREDENTIALS=/absolute/path/to/gcp-oauth.keys.json
#
# Verify before trusting it:  uv run 00_check_calendar.py

# ---------------------------------------------------------------------------
# Telegram front-end (telegram_bot.py). Optional -- the web UI needs none of it.
# Token from @BotFather. The allowlist is what keeps the person graph
# single-tenant: get_store() reads one RECALL_STORE_PATH for the whole process,
# so an unlisted chat would resolve against your contacts. Message the bot once
# and it prints the id to paste here.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# ---------------------------------------------------------------------------
# Hosting (Render). Only needed for the deployed version -- see render.yaml.
# Verify the whole set before deploying:  uv run 00_check_deploy.py
# ---------------------------------------------------------------------------
# Run the Telegram poller inside the web process. One service, not two: a
# Render disk attaches to a single service, so a separate bot worker could not
# read the OAuth token the web service writes.
# RECALL_TELEGRAM=1

# Google Calendar over OAuth (RECALL_CALENDAR=google). The user consents once
# in a browser; no per-machine credential, unlike the MCP path above.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# These two must agree with each other AND with the authorised redirect URI on
# the OAuth client. They disagree silently -- the error appears in the user's
# browser, never in your logs.
# PUBLIC_BACKEND_URL=https://recall.onrender.com
# GOOGLE_REDIRECT_URI=https://recall.onrender.com/oauth/google/callback

# Encrypts the stored refresh token at rest. Generate one:
#   uv run 00_check_deploy.py --new-key
# Lose it and the stored token cannot be read -- delete the token file and
# reconnect. Rotating it has the same effect.
# RECALL_TOKEN_KEY=
# RECALL_GOOGLE_TOKEN_PATH=data/google_token.json
