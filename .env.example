# ---------------------------------------------------------------------------
# Bedrock
# ---------------------------------------------------------------------------
# Region is set twice in most setups (SSO region vs CLI default) and Bedrock
# follows the CLI default -- pin it here so both agree.
AWS_REGION=ap-southeast-1

# WORKSHOP ACCOUNT (SSO): uncomment, then `aws sso login --profile workshop`
# AWS_PROFILE=workshop

# PERSONAL ACCOUNT (no SSO): leave AWS_PROFILE unset and run `aws configure`
# with an IAM user access key. Your IAM user needs the AWS managed policy
# 'AmazonBedrockFullAccess'. Do NOT put the secret key in this file -- let
# `aws configure` write it to ~/.aws/credentials, which is gitignored by default
# and not sitting in your repo.

# Override the model id when the account cannot call the code default. Personal
# accounts usually cannot: Anthropic and OpenAI models on Bedrock are gated
# behind a marketplace subscription form, and the symptom is
# `ValidationException: invalid model identifier`, which reads like a typo.
# Amazon Nova is first-party and works without that gate. Confirm with:
#   uv run 00_check_bedrock.py --list-models
RECALL_MODEL_ID=global.amazon.nova-2-lite-v1:0
# On an account with Anthropic access, use e.g.:
# RECALL_MODEL_ID=apac.anthropic.claude-haiku-4-5-20251001-v1:0

# ---------------------------------------------------------------------------
# Transcription. Free tier. Only needed to run audio memos rather than text.
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Enrichment. Optional -- the enricher falls back to keyless DuckDuckGo search.
# Set at most one; first match wins in this order.
# ---------------------------------------------------------------------------
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# ---------------------------------------------------------------------------
# Backends
# ---------------------------------------------------------------------------
# Memory: local (JSON on disk) | agentcore
RECALL_MEMORY=local
RECALL_STORE_PATH=data/person_graph.json

# Calendar: local (JSON ledger) | mcp
RECALL_CALENDAR=local
# GCAL_MCP_COMMAND=npx -y @cocal/google-calendar-mcp
# GCAL_MCP_TOOL=create-event
